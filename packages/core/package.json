{
  "name": "@minkinad/api-sdk-generator-core",
  "version": "0.2.0",
  "description": "Core OpenAPI to TypeScript SDK generation engine for api-sdk-generator.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "openapi-types": "^12.1.3",
    "prettier": "^3.5.3",
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "author": "minkinad",
  "homepage": "https://minkinad.github.io/api-sdk-generator/",
  "bugs": {
    "url": "https://github.com/minkinad/api-sdk-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minkinad/api-sdk-generator.git",
    "directory": "packages/core"
  },
  "keywords": [
    "openapi",
    "sdk",
    "typescript",
    "codegen",
    "fetch"
  ]
}
