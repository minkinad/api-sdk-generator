{
  "name": "api-sdk-generator-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @minkinpackages/demo build && pnpm --filter @minkinpackages/docs build",
    "dev": "pnpm --filter @minkinpackages/docs dev",
    "test": "pnpm --filter @minkinad/api-sdk-generator-core test && pnpm --filter api-sdk-generator test",
    "test:watch": "pnpm --parallel --filter @minkinad/api-sdk-generator-core --filter api-sdk-generator test:watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter @minkinad/api-sdk-generator-core typecheck && pnpm --filter api-sdk-generator typecheck && pnpm --filter @minkinpackages/demo typecheck && pnpm --filter @minkinpackages/docs typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm build:packages && node scripts/publish.mjs",
    "docs:dev": "pnpm --filter @minkinpackages/docs dev",
    "docs:build": "pnpm --filter @minkinpackages/docs build",
    "docs:preview": "pnpm --filter @minkinpackages/docs preview",
    "build:packages": "pnpm --filter @minkinad/api-sdk-generator-core build && pnpm --filter api-sdk-generator build",
    "release:check": "pnpm build:packages && node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "^6.4.3",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2"
    }
  }
}
